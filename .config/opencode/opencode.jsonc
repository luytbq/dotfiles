{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "agent-code-diff-review": {
            "description": "Reviews uncommited code diffs for best practices and potential issues",
            "mode": "subagent",
            "model": "anthropic/claude-opus-4.5",
            "prompt": "You are a code reviewer. Reviews changes in code diffs. Focus on breaking changes, security, and maintainability.",
            "tools": {
                "edit": false,
                "write": false
            }
        },
        "agent-code-review": {
            "description": "Reviews code for best practices and potential issues",
            "mode": "subagent",
            "model": "anthropic/claude-opus-4.5",
            "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
            "tools": {
                "edit": false,
                "write": false
            }
        },
        "build": {
            "mode": "primary",
            "model": "anthropic/claude-opus-4.5",
            "tools": {} // all tools enabled by default
        },
        "dotfiles": {
            "description": "Manages and updates dotfiles for system configuration",
            "mode": "subagent",
            "model": "anthropic/claude-opus-4.5-mini",
            "prompt": "You are a dotfiles manager. Help manage and update dotfiles for system configuration. When use `git` tool, always use `dotfiles` command instead of `git`. When asked to push, ***ONLY*** push one commit at a time.",
            "tools": {}
        },
        "plan": {
            "mode": "primary",
            "model": "anthropic/claude-opus-4.5",
            "tools": {
                "edit": false,
                "write": false
            }
        }
    },
    "autoupdate": true,
    "keybinds": {
        "agent_cycle": "tab",
        "agent_cycle_reverse": "shift+tab",
        "agent_list": "<leader>a",
        "app_exit": "none",
        "command_list": "ctrl+p",
        "editor_open": "<leader>e",
        "history_next": "down",
        "history_previous": "up",
        "input_clear": "ctrl+l",
    // "input_forward_delete": "none",
    "input_newline": "ctrl+n",
    "input_paste": "ctrl+v",
    "input_submit": "ctrl+s",
    "leader": "ctrl+x",
    "messages_copy": "<leader>y",
    "messages_first": "ctrl+g,home",
    "messages_half_page_down": "ctrl+alt+d",
    "messages_half_page_up": "ctrl+alt+u",
    "messages_last": "ctrl+alt+g,end",
    "messages_last_user": "none",
    "messages_page_down": "ctrl+d",
    "messages_page_up": "ctrl+u",
    "messages_redo": "<leader>r",
    "messages_toggle_conceal": "<leader>h",
    "messages_undo": "<leader>u",
    "model_cycle_recent": "f2",
    "model_cycle_recent_reverse": "shift+f2",
    "model_list": "<leader>m",
    "session_child_cycle": "<leader>+right",
    "session_child_cycle_reverse": "<leader>+left",
    "session_compact": "<leader>c",
    "session_export": "<leader>x",
    "session_interrupt": "escape",
    "session_list": "<leader>l",
    "session_new": "<leader>n",
    "session_share": "none",
    "session_timeline": "<leader>g",
    "session_unshare": "none",
    "sidebar_toggle": "<leader>b",
    "status_view": "<leader>s",
    "theme_list": "<leader>t",
    "username_toggle": "none"
    },
    "mcp": {
        "gitlab-onepay": {
            "type": "local",
            "command": ["npx", "-y", "@zereight/mcp-gitlab"],
            "environment": {
                "GITLAB_PERSONAL_ACCESS_TOKEN": "$GITLAB_PERSONAL_ACCESS_TOKEN",
                "GITLAB_API_URL": "https://git.onepay.vn",
                // "GITLAB_PROJECT_ID": "your_project_id", // Optional: default project
                // "GITLAB_ALLOWED_PROJECT_IDS": "", // Optional: comma-separated list of allowed project IDs
                "GITLAB_READ_ONLY_MODE": "true",
                "USE_GITLAB_WIKI": "true", // use wiki api?
                "USE_MILESTONE": "false", // use milestone api?
                "USE_PIPELINE": "true" // use pipeline api?
            },
            "enabled": true
        },
        "oracle_msp": {
            "type": "local",
            "command": [
                "bash", "-c",
                "docker run -i --rm -e ORACLE_CONNECTION_STRING=\"$ORACLE_MSP_CONNECTION_STRING\" -e READ_ONLY_MODE=true -e THICK_MODE=1 dmeppiel/oracle-mcp-server"
            ],
            "enabled": true
        },
        "oracle_onecredit": {
            "type": "local",
            "command": [
                "bash", "-c",
                "docker run -i --rm -e ORACLE_CONNECTION_STRING=\"$ORACLE_ONECREDIT_CONNECTION_STRING\" -e READ_ONLY_MODE=true -e THICK_MODE=1 dmeppiel/oracle-mcp-server"
            ],
            "enabled": true
        },
        "oracle_prsp": {
            "type": "local",
            "command": [
                "bash", "-c",
                "docker run -i --rm -e ORACLE_CONNECTION_STRING=\"$ORACLE_PRSP_CONNECTION_STRING\" -e READ_ONLY_MODE=true -e THICK_MODE=1 dmeppiel/oracle-mcp-server"
            ],
            "enabled": true
        },
        "word-document-server": {
            "type": "local",
            "command": [
                "bash", "-c",
                "python3 \"$WORD_MCP_SERVER_PATH\""
            ],
            "enabled": true
        }
    },
    "model": "anthropic/claude-opus-4.5",
    "theme": "tokyonight"
}
